{
  "$schema": "./config_schema.json",
  "version": "1.0.0",
  "environment": "development",
  "skill": {
    "name": "endangered-species-forecast-advisor",
    "version": "1.0.0",
    "description": "Conservation biology advisory skill for extinction-risk analysis, root-cause diagnosis, and conservation-strategy design using IUCN Red List criteria, population viability analysis, and evidence-based frameworks.",
    "compatibility": {
      "requiredTools": [
        "iucn_criteria_assessor",
        "threat_classifier",
        "strategy_generator",
        "triage_calculator"
      ],
      "optionalTools": [],
      "dependencies": {
        "lifecycle_hooks": "./hooks/lifecycle_hooks.js",
        "state_sync_hooks": "./hooks/state_sync_hooks.js"
      }
    }
  },
  "system": {
    "contextWindow": {
      "maxTokens": 200000,
      "warningThreshold": 150000,
      "strategy": "progressive_disclosure"
    },
    "performance": {
      "caching": {
        "enabled": true,
        "ttl": 3600000,
        "maxSize": 100
      },
      "parallelProcessing": {
        "enabled": true,
        "maxConcurrency": 5
      },
      "monitoring": {
        "enabled": true,
        "metrics": ["processingTime", "tokenUsage", "cacheHitRate"],
        "exportInterval": 300000
      }
    },
    "errorHandling": {
      "strategy": "graceful_fallback",
      "retryAttempts": 3,
      "retryDelay": 1000,
      "fallbackBehavior": "partial_results",
      "errorLogging": {
        "enabled": true,
        "level": "error",
        "includeStackTrace": true,
        "includeContext": true
      }
    },
    "logging": {
      "enabled": true,
      "level": "info",
      "format": "structured",
      "outputs": ["console"],
      "debug": false
    }
  },
  "analysis": {
    "frameworks": {
      "iucn_red_list": {
        "enabled": true,
        "referencePath": "./references/iucn_red_list_criteria.md",
        "version": "3.1",
        "parameters": {
          "assessmentPeriodMultiplier": 3,
          "generationLengthDefault": 10,
          "maturityThreshold": 0.8
        }
      },
      "pva": {
        "enabled": true,
        "referencePath": "./references/pva_framework.md",
        "parameters": {
          "timeHorizon": 100,
          "mvpThreshold": 1000,
          "neRatioDefault": 0.2
        }
      },
      "root_cause_diagnostics": {
        "enabled": true,
        "referencePath": "./references/root_cause_diagnostics.md",
        "framework": "HIPPO",
        "additionalCategories": ["climate_change", "disease", "genetic_issues"],
        "evidenceWeights": {
          "strong": 40,
          "moderate": 20,
          "weak": 10
        }
      },
      "conservation_strategy": {
        "enabled": true,
        "referencePath": "./references/conservation_strategy_templates.md",
        "strategyTypes": [
          "protected_area",
          "habitat_corridor",
          "captive_breeding",
          "community_based",
          "integrated"
        ]
      },
      "conservation_triage": {
        "enabled": true,
        "referencePath": "./references/conservation_triage.md",
        "defaultCriteria": {
          "extinctionRisk": 25,
          "costEffectiveness": 20,
          "feasibility": 15,
          "umbrella": 15,
          "distinctiveness": 10,
          "cultural": 10,
          "infeasibility": 5
        }
      }
    },
    "defaultWorkflow": [
      "iucn_red_list",
      "root_cause_diagnostics",
      "conservation_strategy",
      "conservation_triage"
    ]
  },
  "disclaimers": {
    "standing": {
      "enabled": true,
      "text": "This skill provides general, educational, and analytical information only. It is NOT a substitute for advice from qualified professionals (conservation biologists, ecologists, wildlife managers, legal/regulatory authorities). Formal IUCN Red List status determination requires accredited IUCN assessors. On-the-ground conservation action requires qualified conservation biologists and compliance with local, national, and international regulations."
    },
    "formalAssessment": {
      "enabled": true,
      "text": "This is a conceptual assessment for educational and research purposes. Formal IUCN Red List status determination requires accredited IUCN assessors and submission to the IUCN Species Survival Commission."
    },
    "professionalReferral": {
      "enabled": true,
      "text": "For conservation action, consultation with qualified conservation biologists and compliance with relevant regulations is essential."
    },
    "dataQuality": {
      "enabled": true,
      "text": "This assessment is only as good as the available data. Key data gaps are identified in the analysis."
    }
  },
  "integration": {
    "externalAPIs": {
      "iucn": {
        "enabled": false,
        "endpoint": "https://apiv3.iucnredlist.org/api/v3/",
        "apiKey": null,
        "rateLimit": 10000
      },
      "speciesProfile": {
        "enabled": false,
        "endpoint": null,
        "apiKey": null
      }
    },
    "dataSources": {
      "local": {
        "enabled": true,
        "path": "./data"
      },
      "remote": {
        "enabled": false,
        "url": null
      }
    }
  },
  "testing": {
    "enabled": true,
    "testCases": "./evals/evals.json",
    "coverage": {
      "marine": true,
      "terrestrial": true,
      "plants": true,
      "multiSpecies": true
    }
  }
}
